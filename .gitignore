# ---- Universal -----------------------------------------------------------
# Secrets: belt and braces. The hooks scan for leaked credentials, but the
# cheapest leak to prevent is the file git never tracked in the first place.
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.kdbx
secrets.y*ml
!secrets.example.y*ml
credentials.json
service-account*.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.fleet/

# Logs and scratch
*.log
tmp/
.tmp/
.cache/

# ---- Go ------------------------------------------------------------------
bin/
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
go.work
go.work.sum

# ---- Docs ----------------------------------------------------------------
_site/
.docusaurus/
site/

# ---- hme -----------------------------------------------------------------
# Build output
/hme
dist/
# Generated manual pages (make man)
/man/
# A session file is a credential. It lives in the user config directory, never
# here, but make sure a stray copy can never be committed.
session.json
.session-*.tmp
